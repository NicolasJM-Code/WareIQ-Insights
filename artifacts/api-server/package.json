{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:report-import": "esbuild src/lib/own-report-validation.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/wareiq-import-validation.cjs && esbuild ../wareiq/src/lib/legacy-report-import.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/wareiq-legacy-parser.cjs && node --test /tmp/wareiq-import-validation.cjs /tmp/wareiq-legacy-parser.cjs",
    "test:access": "esbuild src/lib/access-catalog.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/wareiq-access-tests.cjs && node --test /tmp/wareiq-access-tests.cjs",
    "test:wms": "esbuild src/lib/wms-connection.test.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=/tmp/wareiq-wms-tests.cjs && node --test /tmp/wareiq-wms-tests.cjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.83",
    "@clerk/shared": "^4.41.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.1",
    "ipaddr.js": "^2.5.0",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "thread-stream": "3.1.0"
  }
}
